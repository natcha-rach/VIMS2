# ==========================================================
# .env.example — ตัวอย่างค่า Environment Variables ที่ระบบต้องใช้
# ==========================================================
#
# วิธีใช้:
#   1. คัดลอกไฟล์นี้แล้วเปลี่ยนชื่อเป็น ".env" (ไฟล์ .env ห้าม commit ขึ้น git เด็ดขาด)
#   2. แก้ค่าด้านล่างให้ตรงกับของจริงของคุณ
#

# ----------------------------------------------------------
# DATABASE_URL
# ----------------------------------------------------------
# Connection string ของ PostgreSQL ที่ Prisma จะต่อเข้าไปใช้งาน
# รูปแบบ: postgresql://<user>:<password>@<host>:<port>/<database_name>
#
# ตัวอย่าง (รัน Postgres เองในเครื่องผ่าน Docker):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vims_shop"
#
# ตัวอย่าง (ใช้ Railway/Render/Supabase Postgres แบบ managed):
#   DATABASE_URL="postgresql://user:pass@host.railway.app:5432/railway"
DATABASE_URL=""


# ----------------------------------------------------------
# JWT_SECRET
# ----------------------------------------------------------
# กุญแจลับที่ใช้เซ็น/ตรวจสอบ JWT token ตอน login
#
# **สำคัญมาก**: ต้องเปลี่ยนเป็นค่าที่สุ่มเอง ยาวๆ คาดเดายากก่อน deploy จริงเสมอ
# ห้ามใช้ค่า default ที่ตั้งไว้ในโค้ด (jwtConfig.ts) บน production เด็ดขาด
# เพราะถ้าใครรู้ค่านี้ = ปลอมตัวเป็นเจ้าของร้าน login เข้าระบบได้ทันที
#
# สร้างค่าสุ่มง่ายๆ ด้วยคำสั่งนี้ (ใน terminal):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# อายุของ token ก่อนหมดอายุต้อง login ใหม่ เช่น "1h", "7d"
JWT_EXPIRES_IN="7d"


# ----------------------------------------------------------
# PORT
# ----------------------------------------------------------
# Port ที่ backend server จะฟัง request (ต้องตรงกับที่ตั้งใน Dockerfile/docker-compose ถ้าใช้)
PORT=3000


# ----------------------------------------------------------
# CORS_ORIGIN
# ----------------------------------------------------------
# โดเมนของ frontend ที่อนุญาตให้เรียก API นี้ได้ (กัน backend ถูกเรียกจากเว็บอื่นที่ไม่รู้จัก)
# ใส่ได้หลายโดเมน คั่นด้วย , (ไม่ต้องมีเว้นวรรค)
#
# dev: เปิดหน้าเว็บด้วย Live Server (VS Code extension) มักเป็น http://127.0.0.1:5500
# production: ใส่โดเมนจริงที่ deploy frontend ไว้ เช่น https://my-shirt-shop.netlify.app
CORS_ORIGIN="http://localhost:5500,http://127.0.0.1:5500"


# ----------------------------------------------------------
# ค่าสำหรับ prisma/seed.ts (สร้างบัญชีเจ้าของร้านคนแรก)
# ----------------------------------------------------------
# รันด้วย: npm run seed
# ถ้าไม่ตั้งค่าพวกนี้ สคริปต์จะใช้ค่า default ให้เอง (แต่ควรตั้งเองเพื่อความปลอดภัย)
OWNER_EMAIL="owner@shop.local"
OWNER_USERNAME="owner"
OWNER_PASSWORD="ChangeMe123!"
